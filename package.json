{
  "name": "infoeducatie-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend for infoeducatie.ro",
  "scripts": {
    "start": "vite --mode development",
    "dev": "vite --mode development",
    "build": "vite build",
    "build:smoke": "vite build --mode smoke",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run lint && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\""
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infoeducatie/infoeducatie-ui.git"
  },
  "keywords": [
    "website"
  ],
  "author": "InfoEducatie Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/infoeducatie/infoeducatie-ui/issues"
  },
  "homepage": "https://github.com/infoeducatie/infoeducatie-ui",
  "dependencies": {
    "@sentry/react": "^10.67.0",
    "bootstrap": "^5.3.8",
    "classnames": "^2.5.1",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "lucide-react": "^1.25.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.17.3",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "less": "^4.7.0",
    "typescript": "6.0.3",
    "vite": "^8.1.5"
  }
}
